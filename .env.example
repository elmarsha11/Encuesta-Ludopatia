# Copiá este archivo como .env y completá los valores reales.
# El .env NUNCA se sube a GitHub (está en .gitignore).

# Puerto donde escucha el servidor.
PORT=3000

# Dónde vive la base de datos.
#   Local (desarrollo o PC propia): file:encuestas.db
#   Turso (nube):                   libsql://<nombre-de-la-base>.turso.io
DATABASE_URL=file:encuestas.db

# Solo para Turso: token de acceso de la base. Vacío en local.
DATABASE_AUTH_TOKEN=

# 1 si el servidor está detrás de un proxy (Render o ngrok), para obtener la IP real
# de cada persona. En local, sin proxy, dejarlo vacío.
TRUST_PROXY=

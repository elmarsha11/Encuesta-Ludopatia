# Copiá este archivo como .env y completá los valores reales.
# El .env NUNCA se sube a GitHub (está en .gitignore).

# Puerto donde escucha el servidor.
PORT=3000

# Dónde vive la base de datos.
#   Local (desarrollo o PC propia): file:encuestas.db
#   Turso (nube):                   libsql://<nombre-de-la-base>.turso.io
# En Render SOLO Turso: el disco se borra al dormirse, y el servidor no arranca con un archivo.
# `npm run backup` copia la base de esta variable (ver docs/DESPLIEGUE.md).
DATABASE_URL=file:encuestas.db

# Solo para Turso: token de acceso de la base. Vacío en local.
DATABASE_AUTH_TOKEN=

# 1 si el servidor está detrás de un proxy (Render o ngrok), para obtener la IP real
# de cada persona. En local, sin proxy, dejarlo vacío.
TRUST_PROXY=

# Días y horarios en que se puede responder cada encuesta, en hora argentina.
# Formato: "AAAA-MM-DD HH:MM-HH:MM", separados por punto y coma.
# Si una variable está vacía o no existe, esa encuesta está SIEMPRE abierta.
# Ejemplo: VENTANAS_ADOLESCENTES=2026-10-19 08:00-12:00; 2026-10-20 08:00-12:00
VENTANAS_ADOLESCENTES=
VENTANAS_ADULTOS=

# Contraseñas de los resultados (/resultados/). Una por rol, de 12 caracteres o más,
# todas distintas. Si una está VACÍA, ese acceso no existe: cargar la del grupo y la de
# docentes recién al cerrar la encuesta (se reinicia el servidor para que la tome).
#   CLAVE_JULI:      todo, sin ocultar cantidades, control de participación y Excel completo.
#   CLAVE_ADULTOS:   grupo de Administración Financiera: resultados de adultos.
#   CLAVE_DOCENTES:  docentes: resultados de adolescentes.
CLAVE_JULI=
CLAVE_ADULTOS=
CLAVE_DOCENTES=

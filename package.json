{
  "name": "encuesta-ludopatia",
  "version": "0.1.0",
  "private": true,
  "description": "Encuestas anónimas sobre ludopatía para adultos (18+) y adolescentes (12-17).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch --env-file-if-exists=.env backend/server.js",
    "test": "node --test \"backend/test/**/*.test.js\"",
    "schema": "node scripts/generar-schema.js",
    "contenido": "node scripts/generar-contenido.js",
    "resultados": "node --env-file-if-exists=.env scripts/resultados.js",
    "ejemplos-dashboard": "node scripts/generar-ejemplos-dashboard.js",
    "prueba": "node scripts/servidor-de-prueba.js",
    "qr": "node scripts/generar-qr.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "exceljs": "^4.4.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0"
  },
  "devDependencies": {
    "qrcode": "^1.5.4"
  }
}
